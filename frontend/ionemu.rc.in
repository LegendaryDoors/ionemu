// Windows resources for ionemu.exe: the file icon (Explorer, shortcuts) and the version info that Explorer's
// Details tab and Task Manager show. Configured by CMake.
#include <windows.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/branding/ionemu.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "iONemu"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "ionemu"
            VALUE "LegalCopyright", "GNU GPL v3 or later"
            VALUE "OriginalFilename", "ionemu.exe"
            VALUE "ProductName", "iONemu"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
